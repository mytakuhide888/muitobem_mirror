# /etc/caddy/Caddyfile
muitobem.top, www.muitobem.top {
    encode gzip

    # 動的ページにはキャッシュさせない
    handle {
        header {
            # HTML/JSON等の動的レスポンスは都度取得
            Cache-Control "no-store"
            Referrer-Policy "same-origin"
            X-Content-Type-Options "nosniff"
        }
        reverse_proxy django:8000
    }

    # 静的ファイルだけ長期キャッシュ
    handle_path /static/* {
        root * /srv/static
        header {
            Cache-Control "public, max-age=604800, immutable"
            Referrer-Policy "same-origin"
            X-Content-Type-Options "nosniff"
        }
        file_server
    }
    
    # まず /static/* をファイルサーバで返す
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # それ以外は Django へ
    handle {
        reverse_proxy django:8000
    }
}
